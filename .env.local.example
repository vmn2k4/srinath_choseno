# Environment variables for local development
# Copy this file to .env.local and fill in your values
# .env.local is git-ignored and should never be committed

# E2E test fixture password (used by Playwright tests)
# This password is used by e2e/helpers.ts and sql/seed_e2e_users.sql
# IMPORTANT: Use a DIFFERENT password than production. Keep it secure but it's only for dev.
E2E_TEST_PASSWORD=your_secure_e2e_password_here

# Debug mode password (used by dev-only DebugUserSwitcher component)
# Only exposed in development (NEXT_PUBLIC_ prefix). Never used in production.
# Pairs with sql/seed_debug_personas.sql
NEXT_PUBLIC_DEBUG_PASSWORD=your_secure_debug_password_here
