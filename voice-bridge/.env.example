PORT=3001

# xAI Voice Agent (console.x.ai) -- the same agent_id already connected to
# your Twilio number.
XAI_API_KEY=
XAI_AGENT_ID=agent_shN9BTY161X5G4oQ

# Where the main Choseno app is deployed -- used to POST the final
# transcript/outcome to /api/telephony/complete when a call ends.
CHOSENO_APP_URL=https://www.choseno.com

# Must match INTERNAL_WEBHOOK_SECRET in the main app's environment exactly
# -- generate one with `openssl rand -hex 32` and set it in BOTH places.
INTERNAL_WEBHOOK_SECRET=
