# Copy this file to `.env` (git-ignored) and fill in your Supabase
# project's actual values — Project Settings → API in the Supabase
# dashboard. These are safe to ship in a built app (RLS is the real
# protection, see docs/CODE_LAYERS.md in the parent repo), this is only
# about keeping per-environment config out of source control.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
