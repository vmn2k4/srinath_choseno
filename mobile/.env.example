# Copy this file to `.env` (git-ignored) and fill in your Supabase
# project's actual values — Project Settings → API in the Supabase
# dashboard. These are safe to ship in a built app (RLS is the real
# protection, see docs/CODE_LAYERS.md in the parent repo), this is only
# about keeping per-environment config out of source control.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google sign-in: public OAuth client IDs from Google Cloud -> Credentials.
# WEB = the Web application client (also set as Supabase's Google provider);
# IOS = the iOS client for this app's bundle ID. Leave blank to hide the button.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
