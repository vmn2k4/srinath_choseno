<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.choseno.masternews</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/vmn2k4/Coding/Choseno/scripts/run-hourly-news.sh</string>
    </array>

    <!-- Run every 3600 seconds (1 hour) -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Run immediately when loaded -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/vmn2k4/Coding/Choseno/scripts/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vmn2k4/Coding/Choseno/scripts/launchd-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/vmn2k4/Coding/Choseno</string>
</dict>
</plist>
