{
  "name": "choseno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "import:office-holders": "ts-node scripts/import-office-holders.ts scripts/office-holders-data.csv",
    "import:office-holders:custom": "ts-node scripts/import-office-holders.ts",
    "send-invites": "ts-node scripts/send-politician-invites.ts",
    "send-invites:test": "head -6 scripts/bc-municipal-outreach.csv > scripts/test.csv && ts-node scripts/send-politician-invites.ts scripts/test.csv 'Test Campaign'",
    "send-invites:mayors": "ts-node scripts/send-politician-invites.ts scripts/bc-municipal-outreach.csv 'BC Mayors & Councillors 2026'",
    "send-invites:parties": "ts-node scripts/send-politician-invites.ts scripts/bc-civic-parties-contacts.csv 'BC Civic Parties 2026'",
    "fetch:trends": "node scripts/fetch-trending-topics.js",
    "ingest:news-batch": "node --import tsx scripts/insert-news-batch.js"
  },
  "dependencies": {
    "@google-analytics/data": "^6.1.0",
    "@next/third-parties": "^16.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.43.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "ws": "^8.21.3"
  }
}
